import Roitman.ConstructionSupport
import Roitman.Recursion
import Mathlib.SetTheory.Cardinal.Continuum

/-! Combinatorial definitions for the CH refinement. No forcing is used. -/
noncomputable section
namespace Roitman
open Bookkeeping

/-- Positivity against the ideal generated by the earlier family and finite
sets. A natural-number bound represents the arbitrary finite exceptional set. -/
def PositiveBefore (ξ : I) (A : I → Set ℕ) (X : Set (Finset ℕ)) : Prop :=
  ∀ u : Finset I, (∀ η ∈ u, η < ξ) → ∀ N : ℕ,
    ∃ s ∈ X, s.Nonempty ∧ ∀ i ∈ s, N ≤ i ∧ ∀ η ∈ u, i ∉ A η

/-- Positivity against the ideal generated by the entire indexed family. -/
def Positive (A : I → Set ℕ) (X : Set (Finset ℕ)) : Prop :=
  ∀ u : Finset I, ∀ N : ℕ,
    ∃ s ∈ X, s.Nonempty ∧ ∀ i ∈ s, N ≤ i ∧ ∀ η ∈ u, i ∉ A η

/-- Membership in the ideal generated by the members of `A` and the finite
sets: containment in a finite union, modulo a finite initial segment. -/
def InGeneratedIdeal (A : I → Set ℕ) (B : Set ℕ) : Prop :=
  ∃ u : Finset I, ∃ N : ℕ,
    ∀ i ∈ B, i < N ∨ ∃ η ∈ u, i ∈ A η

def IdealPositive (A : I → Set ℕ) (X : Set (Finset ℕ)) : Prop :=
  ∀ B, InGeneratedIdeal A B →
    ∃ s ∈ X, s.Nonempty ∧ Disjoint (↑s : Set ℕ) B

theorem positive_iff_idealPositive (A : I → Set ℕ) (X : Set (Finset ℕ)) :
    Positive A X ↔ IdealPositive A X := by
  constructor
  · intro hp B hB
    obtain ⟨u, N, hcover⟩ := hB
    obtain ⟨s, hs, hne, havoid⟩ := hp u N
    refine ⟨s, hs, hne, Set.disjoint_left.mpr ?_⟩
    intro i hi hiB
    rcases hcover i hiB with hsmall | ⟨η, hη, hiη⟩
    · exact (not_lt_of_ge (havoid i hi).1) hsmall
    · exact (havoid i hi).2 η hη hiη
  · intro hp u N
    let B : Set ℕ := {i | i < N ∨ ∃ η ∈ u, i ∈ A η}
    obtain ⟨s, hs, hne, hdis⟩ := hp B ⟨u, N, fun _ hi => hi⟩
    refine ⟨s, hs, hne, fun i hi => ⟨?_, ?_⟩⟩
    · apply le_of_not_gt
      intro hsmall
      exact Set.disjoint_left.mp hdis hi (Or.inl hsmall)
    · intro η hη hiη
      exact Set.disjoint_left.mp hdis hi (Or.inr ⟨η, hη, hiη⟩)

def Captured (a : Set ℕ) (X : Set (Finset ℕ)) : Prop :=
  {s | s ∈ X ∧ (↑s : Set ℕ) ⊆ a}.Infinite

def AlmostStronglySeparable (A : I → Set ℕ) : Prop :=
  ∀ X, Positive A X → ∃ ξ, Captured (A ξ) X

def GoodAtCH (d : I → ℕ → ℕ) (X : I → Set (Finset ℕ))
    (ξ : I) (A : I → Set ℕ) : Prop :=
  GoodAt d task ξ A ∧ (PositiveBefore ξ A (X ξ) → Captured (A ξ) (X ξ))

theorem positiveBefore_congr {ξ : I} {A B : I → Set ℕ} {X : Set (Finset ℕ)}
    (h : ∀ η, η < ξ → A η = B η) :
    PositiveBefore ξ A X ↔ PositiveBefore ξ B X := by
  constructor <;> intro hp u hu N
  · obtain ⟨s, hs, hne, havoid⟩ := hp u hu N
    refine ⟨s, hs, hne, fun i hi => ⟨(havoid i hi).1, ?_⟩⟩
    intro η hη
    rw [← h η (hu η hη)]
    exact (havoid i hi).2 η hη
  · obtain ⟨s, hs, hne, havoid⟩ := hp u hu N
    refine ⟨s, hs, hne, fun i hi => ⟨(havoid i hi).1, ?_⟩⟩
    intro η hη
    rw [h η (hu η hη)]
    exact (havoid i hi).2 η hη

theorem goodAtCH_locality (d : I → ℕ → ℕ) (X : I → Set (Finset ℕ))
    (ξ : I) (A B : I → Set ℕ) (h : ∀ η, η ≤ ξ → A η = B η) :
    GoodAtCH d X ξ A ↔ GoodAtCH d X ξ B := by
  unfold GoodAtCH
  rw [goodAt_locality d task task_fst_le ξ A B h,
    positiveBefore_congr (fun η hη => h η hη.le), h ξ le_rfl]

theorem goodCH_almostStronglySeparable {d : I → ℕ → ℕ}
    {X : I → Set (Finset ℕ)} {A : I → Set ℕ}
    (hX : Function.Surjective X) (hA : ∀ ξ, GoodAtCH d X ξ A) :
    AlmostStronglySeparable A := by
  intro Y hY
  obtain ⟨ξ, rfl⟩ := hX Y
  exact ⟨ξ, (hA ξ).2 (fun u _ N => hY u N)⟩

/-- The CH recursion bridge. The premise is the explicit single-stage
extension obligation, discharged separately by the finite-block construction. -/
theorem ch_construction_of_extension (d : I → ℕ → ℕ)
    (X : I → Set (Finset ℕ))
    (extend : ∀ ξ A, (∀ η, η < ξ → GoodAtCH d X η A) →
      ∃ a, GoodAtCH d X ξ (Function.update A ξ a)) :
    ∃ A, ∀ ξ, GoodAtCH d X ξ A := by
  exact local_recursion (GoodAtCH d X) (goodAtCH_locality d X) extend

theorem cardinal_finite_families : Cardinal.mk (Set (Finset ℕ)) = Cardinal.continuum := by
  simp

/-- CH provides the enumeration of all finite-set families used by the
refinement. The equality convention is continuum = aleph one. -/
def chEnumeration (hCH : Cardinal.continuum = Cardinal.aleph 1) :
    I ≃ Set (Finset ℕ) :=
  Classical.choice (Cardinal.eq.mp (by rw [cardinal_I, cardinal_finite_families, hCH]))

/-- Under CH, all natural-number functions also admit an omega-one indexing. -/
def chFunctionEnumeration (hCH : Cardinal.continuum = Cardinal.aleph 1) :
    I ≃ (ℕ → ℕ) :=
  Classical.choice (Cardinal.eq.mp (by
    rw [cardinal_I, Cardinal.mk_arrow]
    simpa only [Cardinal.mk_nat, Cardinal.lift_id, Cardinal.aleph0_power_aleph0] using hCH.symm))

end Roitman
